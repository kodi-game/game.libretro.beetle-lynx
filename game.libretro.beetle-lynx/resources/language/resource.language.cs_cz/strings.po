msgctxt "Addon Summary"
msgid "Atari - Lynx (Beetle Lynx)"
msgstr "Atari - Lynx (Beetle Lynx)"

msgctxt "Addon Description"
msgid "Beetle Lynx is the Atari Lynx module of Beetle, a fork of Mednafen. The Mednafen module is a fork of Handy."
msgstr "Beetle Lynx je modul Atari Lynx emulátoru Beetle, odvozeného od Mednafenu. Modul v Mednafenu je odvozen od Handy."

# Empty string with ID 30000
msgctxt "#30001"
msgid "Auto-rotate Screen"
msgstr "Automatické otočení obrazovky"

msgctxt "#30002"
msgid "Virtually rotate screen orientation and button mappings automatically for known games. When set to 'Manual', screen rotation is adjusted by pressing the SELECT button, otherwise a fixed rotation can be set to either 0, 90, 180 or 270 degrees counter-clockwise."
msgstr "U známých her automaticky otočit orientaci obrazovky a mapování tlačítek. Při nastavení na „Ručně“ se otočení obrazovky upravuje stisknutím tlačítka SELECT, jinak lze pevné otočení nastavit na 0, 90, 180 nebo 270 stupňů proti směru hodinových ručiček."

msgctxt "#30003"
msgid "Auto"
msgstr "Automaticky"

msgctxt "#30004"
msgid "Manual"
msgstr "Ručně"

msgctxt "#30005"
msgid "Color Format (Restart Required)"
msgstr "Formát barev (vyžaduje restart)"

msgctxt "#30006"
msgid "16-Bit (RGB565)"
msgstr "16bitové (RGB565)"

msgctxt "#30007"
msgid "32-Bit (RGB8888)"
msgstr "32bitové (RGB8888)"

msgctxt "#30008"
msgid "Force 60Hz"
msgstr "Vynutit 60 Hz"

msgctxt "#30009"
msgid "Force 60Hz instead of original 75Hz refresh rate, for perfectly smooth movement on 60Hz displays"
msgstr "Vynutit 60 Hz namísto původní obnovovací frekvence 75 Hz pro dokonale plynulý pohyb na displejích s frekvencí 60 Hz"

