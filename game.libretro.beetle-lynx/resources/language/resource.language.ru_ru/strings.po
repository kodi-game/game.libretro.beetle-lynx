msgctxt "Addon Summary"
msgid "Atari - Lynx (Beetle Lynx)"
msgstr "Atari - Lynx (Beetle Lynx)"

msgctxt "Addon Description"
msgid "Beetle Lynx is the Atari Lynx module of Beetle, a fork of Mednafen. The Mednafen module is a fork of Handy."
msgstr "Beetle Lynx — это модуль Atari Lynx из Beetle, форка Mednafen. Модуль Mednafen является ответвлением Handy."

# Empty string with ID 30000
msgctxt "#30001"
msgid "Auto-rotate Screen"
msgstr "Автоповорот экрана"

msgctxt "#30002"
msgid "Virtually rotate screen orientation and button mappings automatically for known games. When set to 'Manual', screen rotation is adjusted by pressing the SELECT button, otherwise a fixed rotation can be set to either 0, 90, 180 or 270 degrees counter-clockwise."
msgstr "Виртуально поворачивать ориентацию экрана и сопоставления кнопок автоматически для известных игр. Если установлено «Вручную», поворот экрана настраивается нажатием кнопки SELECT, иначе можно задать фиксированный поворот на 0, 90, 180 или 270 градусов против часовой стрелки."

msgctxt "#30003"
msgid "Auto"
msgstr "Авто"

msgctxt "#30004"
msgid "Manual"
msgstr "Вручную"

msgctxt "#30005"
msgid "Color Format (Restart Required)"
msgstr "Формат цвета (требуется перезапуск)"

msgctxt "#30006"
msgid "16-Bit (RGB565)"
msgstr "16-бит (RGB565)"

msgctxt "#30007"
msgid "32-Bit (RGB8888)"
msgstr "32-бит (RGB8888)"

msgctxt "#30008"
msgid "Force 60Hz"
msgstr "Принудительно 60 Гц"

msgctxt "#30009"
msgid "Force 60Hz instead of original 75Hz refresh rate, for perfectly smooth movement on 60Hz displays"
msgstr "Принудительно 60 Гц вместо оригинальной частоты обновления 75 Гц, для идеально плавного движения на дисплеях 60 Гц"

